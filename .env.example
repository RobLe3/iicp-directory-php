APP_NAME="IICP Directory"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://iicp.network

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_LEVEL=warning

# Dedicated IICP directory database — do NOT share with other application databases
# Create via hosting panel: database name iicp_directory, user iicp_dir_user
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=iicp_directory
DB_USERNAME=iicp_dir_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Cache + rate limiting uses database driver — no Redis required
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@iicp.network"
MAIL_FROM_NAME="${APP_NAME}"

# Scheduler — add this cron job via hosting control panel (cPanel > Cron Jobs):
# * * * * * cd /home/<user>/public_html/directory && /opt/alt/php83/usr/bin/php artisan schedule:run >> /dev/null 2>&1
IICP_SCHEDULER_ENABLED=true

# Injected by the guarded release builder. Do not set manually in development.
IICP_BUILD_ID=
IICP_DEPLOYMENT_KIND=
IICP_RELEASE_TAG=
IICP_SOURCE_COMMIT=
IICP_DEPLOYED_AT=
IICP_OPENAPI_VERSION=1.7.0
IICP_PROTOCOL_MIN=1.9.0
IICP_PROTOCOL_MAX=1.9.0
IICP_ROOT_KEY_ID=
IICP_IMAGE_DIGEST=
IICP_SBOM_DIGEST=

# Set to true to skip the endpoint liveness check during node registration.
# Useful for alpha/dev environments where nodes are on private LAN IPs.
# Default: false (liveness check is enforced in production)
IICP_SKIP_LIVENESS_CHECK=false

# Set to 0 to disable the per-source active-node capacity gate.
IICP_REGISTER_MAX_ACTIVE_NODES_PER_IP=20

# Federation/replica mode. Production URLs must use HTTPS.
IICP_REPLICA_MODE=false
IICP_SEED_URL=
IICP_DEV_ALLOW_HTTP_DID=false

# Optional seed-side load redirect.
IICP_REDIRECT_ENABLED=false
IICP_REPLICA_URLS=
IICP_REDIRECT_TRUST_TIER=low
IICP_REDIRECT_RETRY_AFTER=5

# DB hygiene (#604): bounded hot windows for operational telemetry. Long-term
# trust/reputation/accounting state remains in dedicated tables; raw probe rows
# are pruned in small batches by the scheduler.
IICP_TELEMETRY_PROBE_RETENTION_DAYS=14
IICP_TELEMETRY_AGGREGATE_RETENTION_DAYS=30
IICP_PROXY_TELEMETRY_RETENTION_DAYS=30
IICP_HEARTBEAT_EVENT_RETENTION_DAYS=1
IICP_TELEMETRY_PRUNE_BATCH=1000
IICP_TELEMETRY_PRUNE_MAX_BATCHES=5

# S.14 — Genesis Seed signing key for genesis-verified badge issuance (BADGE-01)
# Generate a keypair: php -r "require 'vendor/autoload.php'; $kp = sodium_crypto_sign_keypair(); echo 'SECRET: ' . base64_encode(sodium_crypto_sign_secretkey($kp)) . PHP_EOL . 'PUBLIC: ' . base64_encode(sodium_crypto_sign_publickey($kp)) . PHP_EOL;"
# Store the full 64-byte secret key (base64-encoded). Leave blank to disable genesis-verified issuance.
GENESIS_SEED_SECRET_KEY=
GENESIS_SEED_PUBLIC_KEY=

# S.13 §3.4 / #271 — Genesis Ed25519 event-log signing key (128-char hex = 64-byte
# sodium secret key). When set, every NodeEventLogger event is signed and hash-chained
# (#458); when blank, events are emitted unsigned (Phase 6B opt-in). The matching
# PUBLIC key lives in /.well-known/did.json verificationMethod[0].publicKeyJwk.x.
# Injected by deploy/scripts/build_directory_release.sh from
# deploy/.credentials/genesis_ed25519_credentials.sh.
IICP_GENESIS_ED25519_SECRET_KEY=

# HMAC secret for the /_deploy/migrate endpoint (DeployMigrateController).
# Generate via: openssl rand -hex 32
# Mirror in deploy/.credentials/deploy_secret.sh on the client side.
# Empty = endpoint returns 503 (fail-closed).
IICP_DEPLOY_SECRET=

# Testbed-only trust bypasses. Production ignores both even if set.
IICP_DEV_ALLOW_INSECURE_TLS=false
IICP_DEV_ALLOW_UNSIGNED_EVENTS=false
