# Non-secret operator configuration. Copy outside the repository and provide
# secret file paths separately; never add secret values here.
IICP_APP_URL=https://directory.example
IICP_DB_DATABASE=iicp_directory
IICP_DB_USERNAME=iicp_directory
IICP_OPERATOR_PORT=8080
IICP_IMAGE_TAG=local
IICP_APP_MEMORY=512m
IICP_APP_CPUS=1.0
IICP_DB_MEMORY=1g
IICP_DB_CPUS=1.0
IICP_WEB_MEMORY=128m
IICP_WEB_CPUS=0.5
